# Prevent directory listing
Options -Indexes

# Block execution of scripts inside uploads directory
<FilesMatch "(?i)\.(php|phtml|php3|php4|php5|php7|phps|phar|inc|cgi|pl|py|sh|bash)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>

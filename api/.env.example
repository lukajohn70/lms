# ─────────────────────────────────────────────
#  Aroura LMS — Environment Configuration
#  Copy this file to .env and fill in your values.
#  NEVER commit the real .env to version control.
# ─────────────────────────────────────────────

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=aroura
DB_USERNAME=aroura_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# JWT — generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_USE_OPENSSL_RAND_BASE64_48

# Allowed CORS origin (your school's front-end domain)
CORS_ORIGIN=https://your-school-domain.com

# App environment: production | development
APP_ENV=production
